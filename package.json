{
  "name": "sil-procurement",
  "private": true,
  "description": "Hospital Procurement, Supply Chain & Inventory system",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @sil/shared build && pnpm --filter @sil/api build && pnpm --filter @sil/web build",
    "build:shared": "pnpm --filter @sil/shared build",
    "dev:api": "pnpm --filter @sil/api dev",
    "dev:web": "pnpm --filter @sil/web dev",
    "db:migrate": "pnpm --filter @sil/api db:migrate",
    "db:seed": "pnpm --filter @sil/api db:seed",
    "test": "pnpm build:shared && pnpm --filter @sil/api test && pnpm --filter @sil/web test",
    "test:api": "pnpm build:shared && pnpm --filter @sil/api test",
    "test:web": "pnpm --filter @sil/web test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "body-parser@<2.4.0": "^2.4.0",
      "multer@<2.5.0": "^2.5.0",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "uuid@>=9 <11.1.1": "^11.1.1"
    }
  }
}
